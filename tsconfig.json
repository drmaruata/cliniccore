{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // DELIBERATE EXCEPTION (brief Step 2). exactOptionalPropertyTypes is the one
    // strict-family flag left off: it makes `{ prop?: T }` reject an explicit
    // `prop: undefined`, which collides with the prop types shipped by
    // React, shadcn/ui and Supabase SSR. Enabling it would mean casting at every
    // third-party component boundary. Rationale and the revisit condition are in
    // docs/IMPLEMENTATION_STATUS.md.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "playwright-report", "test-results"]
}
