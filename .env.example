# ClinicCore environment template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Values below are inert placeholders, not credentials.

# Browser-safe Supabase config. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the
# canonical name; NEXT_PUBLIC_SUPABASE_ANON_KEY is the legacy fallback used only
# when the publishable key is absent.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import from app/, or any
# "use client" file. Only lib/supabase/server.ts may read this.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Used by Composio MCP to target the right Supabase project for migrations.
SUPABASE_PROJECT_REF=your_project_ref

# SERVER ONLY, and only read by tests/integration. The integration suite asserts
# catalogue state (pg_proc, pg_policies, constraint arity), which PostgREST cannot
# return, so it needs a direct connection.
#
# USE THE POOLER, NOT THE DIRECT HOST. Measured from this machine: the direct host
# db.<project-ref>.supabase.co does NOT resolve, while
# aws-0-<region>.pooler.supabase.com does and answers on 5432 and 6543. The
# username for the pooler is postgres.<project-ref>, not plain postgres.
TEST_DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000